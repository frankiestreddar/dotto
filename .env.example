# Copy this file to .env.local and fill in real values. Never commit .env.local (already
# gitignored via the blanket .env* rule) — see README.md for where to get each of these.

# Supabase project URL and anon (public) key — Settings > API in your Supabase project dashboard.
# Used by lib/supabase/client.js (browser) and lib/supabase/server.js (server components/routes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq API key (https://console.groq.com/keys) — powers Dotbot chat/search (app/api/dotbot/*).
GROQ_API_KEY=

# Hugging Face API key (https://huggingface.co/settings/tokens) — used for auxiliary AI features
# alongside Groq (see grep for HUGGINGFACE_API_KEY usage in app/api/dotbot/*).
HUGGINGFACE_API_KEY=

# Vercel OIDC token — only present when running via `vercel dev`/deployed on Vercel; auto-injected,
# not something you set by hand locally. Safe to leave blank for a plain `npm run dev`.
VERCEL_OIDC_TOKEN=

# ---------- e2e testing (see PHASE4_ROADMAP.md, e2e/global-setup.ts) ----------
# Only needed to run `npm run test:e2e`'s "authenticated" project locally — a dedicated test
# Supabase project (kept schema-identical to production, never used for real user data), separate
# from NEXT_PUBLIC_SUPABASE_URL/ANON_KEY above. Same 4 values exist as GitHub Actions repo secrets
# for CI (TEST_SUPABASE_URL, TEST_SUPABASE_ANON_KEY, E2E_TEST_EMAIL, E2E_TEST_PASSWORD).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Supabase CLI personal access token (https://supabase.com/dashboard/account/tokens) — only needed
# for `npm run supabase -- <command>` (linking/pushing migrations), not for running the app itself.
SUPABASE_ACCESS_TOKEN=
