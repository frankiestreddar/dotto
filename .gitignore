# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
# Saved authenticated session state for e2e specs (e2e/global-setup.ts writes here) — contains a
# real session token for whichever Supabase test account it logged in as, never committed.
/e2e/.auth

# Claude Code browser-testing setup (Playwright scripts + saved auth state/test credentials) —
# local-only tooling for interactive verification, not part of the app itself.
/.claude-testing

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local project-link cache (created by `supabase link`) — machine-local, not shared.
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
